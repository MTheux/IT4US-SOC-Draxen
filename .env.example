# Fill before first Compose start; use a password manager generated secret (14+ chars).
EASM_BOOTSTRAP_EMAIL=
EASM_BOOTSTRAP_PASSWORD=
EASM_COOKIE_SECURE=0
EASM_PORT=8765
# Add only after provider access is approved. Prefer CENSYS_API_TOKEN_FILE for a mounted secret.
# CENSYS_API_TOKEN=
# CENSYS_API_TOKEN_FILE=
