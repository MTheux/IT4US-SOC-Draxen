# ======================================================================
# IT4US SOC — Draxen EASM : configuração plug-and-play
# Copie este arquivo para .env e preencha. O .env NUNCA vai para o Git.
#   cp .env.example .env
# ======================================================================

# --- Admin inicial do console (criado no primeiro start) --------------
# Email de login do administrador SOC.
EASM_BOOTSTRAP_EMAIL=
# Senha inicial — use gerador do cofre, mínimo 14 caracteres.
EASM_BOOTSTRAP_PASSWORD=

# --- Censys (o único segredo necessário para rodar o ASM real) --------
# Cole aqui o API Token (Personal Access Token) da conta Censys da IT4US.
# Só isto é obrigatório para a coleta passiva ao vivo.
CENSYS_API_TOKEN=

# --- Opcionais --------------------------------------------------------
# ID da organização Censys. NÃO é obrigatório: deixe vazio e a Censys usa
# a organização padrão do token. Só preencha se a Censys recusar a consulta
# pedindo para especificar a organização (conta com várias organizações).
# CENSYS_ORGANIZATION_ID=

# Alternativa ao token acima: caminho de um arquivo protegido do secret
# manager contendo o token (preferível em instalação compartilhada).
# CENSYS_API_TOKEN_FILE=/caminho/para/censys.token

# Porta local do console (padrão 8765) e cookie seguro atrás de HTTPS.
# EASM_PORT=8765
# EASM_COOKIE_SECURE=0
